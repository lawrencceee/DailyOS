# App
APP_NAME=DailyOS
APP_ENV=development
LOG_LEVEL=INFO

# API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# Database
POSTGRES_USER=dailyos
POSTGRES_PASSWORD=dailyos
POSTGRES_DB=dailyos
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://dailyos:dailyos@db:5432/dailyos

# Auth — REQUIRED. Generate a real random secret for anything beyond
# local dev, e.g.: python3 -c "import secrets; print(secrets.token_hex(32))"
# Never use the default below outside your own machine — anyone who
# knows it can forge valid login tokens for any user.
JWT_SECRET_KEY=dev-only-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# One-time use: if you're running the 0004 migration against a database
# that already has tasks from before auth existed, set these two so
# that pre-existing data gets assigned to an account you can actually
# log into, instead of being deleted. Not needed for a fresh database.
# LEGACY_OWNER_EMAIL=you@example.com
# LEGACY_OWNER_PASSWORD=choose-a-real-password

# Deadline reminder emails (modules/notification/)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-16-character-app-password
ALERT_EMAIL_FROM=you@gmail.com
ALERT_EMAIL_TO=
REMINDER_CHECK_INTERVAL_MINUTES=15
