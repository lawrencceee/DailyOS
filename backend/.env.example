# App
APP_NAME=DailyOS
APP_ENV=development
LOG_LEVEL=INFO

# API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# Database
POSTGRES_USER=dailyos
POSTGRES_PASSWORD=dailyos
POSTGRES_DB=dailyos
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://dailyos:dailyos@db:5432/dailyos

# Deadline reminder emails (modules/notification/)
# ---------------------------------------------------------------
# Sends an email when a task's deadline is ~1 day and ~1 hour away.
# Leave these blank to disable — the scheduler still runs but skips
# sending (see Settings.email_configured in core/config.py).
#
# Easiest free option: a Gmail "App Password" (not your normal Gmail
# password — Google requires a separate 16-character app password for
# this). Generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the account first).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=rimq lkmv jiwo ywju
ALERT_EMAIL_FROM=you@gmail.com
ALERT_EMAIL_TO=you@gmail.com
REMINDER_CHECK_INTERVAL_MINUTES=15
