# Optional. Leave unset to auto-infer the backend's address from
# whatever host the page was loaded from (works for both localhost
# and a phone on the same LAN — see src/services/api.js). Only set
# this explicitly if the backend runs on a different host than the
# frontend, e.g. a deployed environment.
# VITE_API_BASE_URL=http://localhost:8000/api/v1
